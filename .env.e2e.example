# Copie para .env.e2e.local (não commitado) — Playwright / testes E2E locais
# Nunca commite ficheiros com senhas reais.

TERAPROX_E2E_TENANT=
TERAPROX_E2E_USER=
TERAPROX_E2E_PASSWORD=

# URL base (opcional; padrão http://localhost:3000)
# TERAPROX_E2E_BASE_URL=http://localhost:3000

# 0 = não subir `npm start` (usa servidor já a correr). Omitido = Playwright inicia o dev server.
# TERAPROX_E2E_WEB_SERVER=0
