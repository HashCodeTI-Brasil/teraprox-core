{
  "name": "teraprox-ui-kit",
  "version": "0.2.0",
  "description": "Meta-package em transição: re-exporta @teraprox/ui-kit-core + @teraprox/ui-kit-sgm + @teraprox/ui-kit-sgp. Mantém retrocompatibilidade com os 7 remotes federados enquanto os componentes migram (Waves 1-3).",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "style": "dist/index.css",
  "sideEffects": ["**/*.css", "dist/index.css"],
  "exports": {
    ".": {
      "style": "./dist/index.css",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "browser-image-compression": ">=2.0.0",
    "dayjs": ">=1.11.0",
    "file-saver": ">=2.0.0",
    "qr-scanner": ">=1.0.0",
    "qrcode": ">=1.0.0",
    "react": ">=17.0.0",
    "react-bootstrap": ">=2.0.0",
    "react-bootstrap-typeahead": ">=5.0.0",
    "react-color": ">=2.0.0",
    "react-dropzone": ">=14.0.0",
    "react-google-charts": ">=4.0.0",
    "react-icons": ">=4.0.0",
    "react-qr-code": ">=2.0.0",
    "react-redux": ">=7.0.0",
    "react-router-dom": ">=6.0.0",
    "react-select": ">=5.0.0",
    "teraprox-core-sdk": ">=0.3.12",

    "recharts": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "react-bootstrap-typeahead": {
      "optional": true
    },
    "browser-image-compression": {
      "optional": true
    },
    "react-dropzone": {
      "optional": true
    },
    "react-color": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "qr-scanner": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    },
    "react-qr-code": {
      "optional": true
    },
    "file-saver": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    },
    "react-google-charts": {
      "optional": true
    }
  },
  "dependencies": {
    "@teraprox/ui-kit-core": "file:../ui-kit-core",
    "@teraprox/ui-kit-sgm": "file:../ui-kit-sgm",
    "@teraprox/ui-kit-sgp": "file:../ui-kit-sgp"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.0",
    "react-dropzone": "^15.0.0",
    "react-google-charts": "^5.2.1",
    "react-icons": "^5.0.0",
    "react-redux": "^9.0.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.8.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
