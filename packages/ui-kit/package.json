{
  "name": "teraprox-ui-kit",
  "version": "0.1.8",
  "description": "Componentes visuais compartilhados entre módulos federados TeraproX",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/styles/teraprox-base.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-bootstrap": ">=2.0.0",
    "react-icons": ">=4.0.0",
    "react-router-dom": ">=6.0.0",
    "react-redux": ">=7.0.0",
    "react-bootstrap-typeahead": ">=5.0.0",
    "dayjs": ">=1.11.0",
    "browser-image-compression": ">=2.0.0",
    "react-dropzone": ">=14.0.0",
    "react-color": ">=2.0.0",
    "recharts": ">=2.0.0",
    "react-google-charts": ">=4.0.0",
    "qr-scanner": ">=1.0.0",
    "qrcode": ">=1.0.0",
    "react-qr-code": ">=2.0.0",
    "file-saver": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "react-bootstrap-typeahead": {
      "optional": true
    },
    "browser-image-compression": {
      "optional": true
    },
    "react-dropzone": {
      "optional": true
    },
    "react-color": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "qr-scanner": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    },
    "react-qr-code": {
      "optional": true
    },
    "file-saver": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    },
    "react-google-charts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.0",
    "react-icons": "^5.0.0",
    "react-router-dom": "^6.20.0",
    "react-redux": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "license": "UNLICENSED"
}
