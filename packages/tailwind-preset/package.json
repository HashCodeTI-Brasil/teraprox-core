{
  "name": "@hashcodeti/tailwind-preset",
  "version": "1.0.0",
  "description": "Preset Tailwind canônico Teraprox — consome @hashcodeti/design-tokens. Fonte única usada por web-client, MFs federados e ui-kit-*.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": { "optional": true }
  },
  "dependencies": {
    "@hashcodeti/design-tokens": "file:../design-tokens"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
