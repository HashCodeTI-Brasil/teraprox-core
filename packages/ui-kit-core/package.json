{
  "name": "@hashcodeti/ui-kit-core",
  "version": "0.9.0",
  "description": "Primitivos + composites 100% Tailwind+Radix. Wave H.5 adicionou GenericPickerHost<T> (View que consome IGenericPickerViewModel Port em core-sdk — substitui withGenericPicker HOC duplicado em 12 callers SGM cross-MF).",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs",
      "require": "./dist/tokens/index.js"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind.preset.d.ts",
      "import": "./dist/tailwind.preset.mjs",
      "require": "./dist/tailwind.preset.js"
    },
    "./brand/*": "./src/brand/*",
    "./dist/index.css": {
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    }
  },
  "files": [
    "dist",
    "src/brand"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "browser-image-compression": ">=2.0.0",
    "dayjs": ">=1.11.0",
    "file-saver": ">=2.0.0",
    "qr-scanner": ">=1.0.0",
    "qrcode": ">=1.0.0",
    "react": ">=17.0.0",
    "react-bootstrap": "^2.0.0",
    "react-bootstrap-typeahead": ">=5.0.0",
    "react-color": ">=2.0.0",
    "react-dropzone": ">=14.0.0",
    "react-google-charts": ">=4.0.0",
    "react-icons": ">=4.0.0",
    "react-qr-code": ">=2.0.0",
    "react-redux": ">=7.0.0",
    "react-router-dom": ">=6.0.0",
    "react-select": ">=5.0.0",
    "teraprox-core-sdk": ">=0.3.12",
    "recharts": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "react-bootstrap-typeahead": { "optional": true },
    "browser-image-compression": { "optional": true },
    "react-dropzone": { "optional": true },
    "react-color": { "optional": true },
    "recharts": { "optional": true },
    "qr-scanner": { "optional": true },
    "qrcode": { "optional": true },
    "react-qr-code": { "optional": true },
    "file-saver": { "optional": true },
    "dayjs": { "optional": true },
    "react-google-charts": { "optional": true }
  },
  "dependencies": {
    "@hashcodeti/design-tokens": "file:../design-tokens",
    "@hashcodeti/tailwind-preset": "file:../tailwind-preset",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.5.0",
    "teraprox-ui-kit": "file:../ui-kit"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
